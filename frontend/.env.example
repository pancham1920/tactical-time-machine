# Public browser configuration only. Never put a Gemini API key here.
VITE_API_BASE_URL=http://127.0.0.1:8000
# On Vercel, set this to https://your-backend.onrender.com before building.
# Vite embeds this public value at build time; changes require a rebuild.

# Optional LOCAL development only; ignored in production builds:
# VITE_AUTH_MODE=local
# Never embed DEMO_ACCESS_CODE or GEMINI_API_KEY here. Visitors enter their code.
