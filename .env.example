# Copy to .env and replace the placeholder locally. Never commit a real key.
# Hosting: set GEMINI_API_KEY in the backend environment, not the frontend.
# Hosted variables take precedence over local .env values. Do not upload .env.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Matches the current default in src/agents/config.py.
# Choose a model available to your Google API project.
GEMINI_MODEL=gemini-2.5-flash

# Approximate model-input character budget, not a Gemini token limit.
AGENT_CONTEXT_MAX_CHARS=64000

# Exact frontend origins, comma-separated. Setting this replaces the default.
# No paths, trailing slashes, or wildcards. Restart the backend after editing.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Hosted example: CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Deployment build settings, configured on the host after artifact publication.
# These are not secrets. Installer reads process environment, not this .env file.
# FOOTBALL_DB_URL=https://your-artifact-host/football_vault.db.gz
# FOOTBALL_DB_SHA256=copy_artifact_sha256_from_build_manifest

# Optional checkpoint file, relative to project root or an absolute path.
# Default: conversation_memory.db. Keep separate from football_vault.db.
# Render Free example: CONVERSATION_DB_PATH=runtime/conversation_memory.db
# This path does NOT provide persistent storage on a free ephemeral host.

# Invite-only mode fails closed without a strong server-side access code.
AUTH_MODE=invite
DEMO_ACCESS_CODE=replace_with_a_random_access_code
# Keep false until all accounts are confirmed on free/non-billed plans.
DEMO_CHAT_ENABLED=false
# Offline/local learning only: AUTH_MODE=local with loopback Uvicorn.
# Hosted entry point and Render reject local mode. Never expose it publicly.
